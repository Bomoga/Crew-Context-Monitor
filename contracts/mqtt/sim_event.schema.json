{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccm.local/contracts/mqtt/sim_event.schema.json",
  "title": "Simulator event (ccm/sim/event)",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario", "name", "label", "phase", "t_meas", "crew"],
  "properties": {
    "scenario": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "label": {"type": "string", "minLength": 1},
    "phase": {"enum": ["start", "end", "mark"]},
    "t_meas": {"type": "number"},
    "crew": {"type": ["string", "null"], "pattern": "^W[0-9]+$"}
  }
}
